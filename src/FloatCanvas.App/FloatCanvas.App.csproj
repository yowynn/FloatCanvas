<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FloatCanvas.ico</ApplicationIcon>
    <AssemblyName>FloatCanvas</AssemblyName>
    <Product>浮绘 FloatCanvas</Product>
    <Description>可编辑的 Windows 屏幕标注画布</Description>
    <SatelliteResourceLanguages>zh-Hans;zh-CN;en</SatelliteResourceLanguages>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ReleaseTrust.json" LogicalName="FloatCanvas.ReleaseTrust.json" />
    <None Include="../../Docs/User-Guide*.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="$(IntermediateOutputPath)system-overlay/FloatCanvas.SystemOverlay.dll" Link="FloatCanvas.SystemOverlay.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\FloatCanvas.ico" />
    <Resource Include="Assets\FloatCanvas.png" />
    <Resource Include="Assets\FloatCanvas.Hidden.png" />
    <Resource Include="Assets\FloatCanvas.Hidden.ico" />
    <Resource Include="Assets\FloatCanvas.PassThrough.png" />
    <Resource Include="Assets\FloatCanvas.PassThrough.ico" />
    <Resource Include="Assets\FloatCanvas.PassThrough.Hidden.png" />
    <Resource Include="Assets\FloatCanvas.PassThrough.Hidden.ico" />
    <ProjectReference Include="../FloatCanvas.Localization/FloatCanvas.Localization.csproj" />
    <ProjectReference Include="../FloatCanvas.Core/FloatCanvas.Core.csproj" />
    <ProjectReference Include="../FloatCanvas.Rendering/FloatCanvas.Rendering.csproj" />
    <ProjectReference Include="../FloatCanvas.Storage/FloatCanvas.Storage.csproj" />
    <ProjectReference Include="../FloatCanvas.Windows/FloatCanvas.Windows.csproj" />
  </ItemGroup>
  <Target Name="BuildSystemOverlayHost" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)/../FloatCanvas.SystemOverlay.Native/SystemOverlay.cpp;$(MSBuildProjectDirectory)/../FloatCanvas.SystemOverlay.Native/InputSafetyWatchdog.h;$(MSBuildProjectDirectory)/../../scripts/Build-SystemOverlayNative.ps1"
          Outputs="$(IntermediateOutputPath)system-overlay/FloatCanvas.SystemOverlay.dll" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Build-SystemOverlayNative.ps1&quot; -OutputDirectory &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'system-overlay'))&quot;" />
  </Target>
  <Target Name="ExcludeReleasePublishDebugSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
